# ──────────────────────────────────────────────────────────────────────────────
# CivicDetect Mobile App — Environment Variables Template
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────────────

# Backend API base URL
# Physical Android device: use your machine's LAN IP, e.g. http://192.168.1.105:5000/api
# Android emulator:        http://10.0.2.2:5000/api
# iOS simulator / web:     http://127.0.0.1:5000/api
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:5000/api

# Google Maps API Key — required for native map tiles on Android
# Get one from: https://console.cloud.google.com/
# Enable: Maps SDK for Android, Maps SDK for iOS
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
